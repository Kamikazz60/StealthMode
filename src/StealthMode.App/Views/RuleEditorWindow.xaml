<Window x:Class="StealthMode.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Règle de masquage" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Nom de la règle"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12"/>
        <TextBlock Text="Nom du processus (ex. Code, chrome)"/>
        <TextBox x:Name="ProcessBox" Margin="0,4,0,12"/>
        <TextBlock Text="Chemin de l'exécutable (facultatif)"/>
        <TextBox x:Name="PathBox" Margin="0,4,0,12"/>
        <TextBlock Text="Le titre contient (facultatif)"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,8"/>
        <TextBlock Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap"
                   Text="Tous les critères renseignés doivent correspondre. Sans titre, toutes les fenêtres de l'application sont masquées. Au moins un critère est nécessaire."/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</Window>
