<Window x:Class="StealthMode.App.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profils et règles" Width="620" Height="830" MinWidth="380" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Profils" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Foreground="{StaticResource FgDim}" Margin="0,4,0,8">
            <Run Text="Profil actif : "/><Run Text="{Binding ActiveProfileName, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
        </TextBlock>

        <StackPanel Grid.Row="2">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Nouveau" Command="{Binding NewProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button Content="Renommer" Command="{Binding RenameProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button Content="Supprimer" Command="{Binding DeleteProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button Content="Choisir comme actif" Command="{Binding ActivateProfileCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="Règles de ce profil (masquées automatiquement à l'activation)" FontWeight="SemiBold" Margin="0,8,0,8"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10">
            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Summary, Mode=OneWay}" Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Ajouter une règle" Command="{Binding AddRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Modifier" Command="{Binding EditRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Supprimer la règle" Command="{Binding DeleteRuleCommand}" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="Icônes à mettre de côté (Bureau, dossiers)" FontWeight="SemiBold" Margin="0,20,0,4"/>
        <TextBlock Grid.Row="6" Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Ces fichiers, raccourcis ou dossiers sont déplacés dans un dossier de Stealth Mode pendant le mode secret, puis remis exactement à leur place. Ajoutez ici, par exemple, le raccourci de Stealth Mode du Bureau."/>
        <Border Grid.Row="7" Background="{StaticResource Panel}" CornerRadius="10">
            <ListBox ItemsSource="{Binding HiddenItems}" SelectedItem="{Binding SelectedItem}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="8,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <WrapPanel Grid.Row="8" Margin="0,10,0,0">
            <Button Content="Ajouter des fichiers…" Command="{Binding AddItemsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Ajouter un dossier…" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Retirer" Command="{Binding RemoveItemCommand}" Style="{StaticResource SecondaryButton}"/>
        </WrapPanel>

        <!-- Bouton explicite : fermer cette fenêtre (et non l'application) ; les changements sont déjà enregistrés. -->
        <Grid Grid.Row="9" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Les modifications sont enregistrées automatiquement. Fermer cette fenêtre ne quitte pas Stealth Mode."
                       Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Terminer" Style="{StaticResource PrimaryButton}" MinWidth="130" IsCancel="True" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>
