<Window x:Class="StealthMode.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stealth Mode" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
